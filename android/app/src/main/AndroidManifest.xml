<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keeping a drone running with the screen off is a foreground media
         service. Android 14 splits the old blanket FOREGROUND_SERVICE
         permission into typed ones and refuses to start a service whose type
         it has not been granted, so both are declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android 13+ will not show the transport notification without this. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Asking GitHub whether there is a newer build. Flutter's template
         declares this in the debug and profile manifests only - it is what the
         tooling needs to reach the running app - so a release build has no
         network at all unless it is said here. The failure is silent and looks
         exactly like being offline: every request fails and the updater
         reports that it could not reach GitHub. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The app updates itself. A television has no store to update from and no
         comfortable way to retype a download address, so it fetches the new APK
         and hands it to the system installer - which will not open for an app
         that has not declared this. The user still has to allow it per-app and
         still has to confirm the install; this only makes the asking possible. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Leanback is the television UI, and required="false" rather than "true"
         so the same APK still installs on a handset - useful for looking at it
         without a TV in the room. What must be declared either way is that a
         touchscreen is optional: it defaults to required, and a TV has none, so
         leaving this out is how an app becomes invisible to every television
         there is. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>

    <application
        android:label="Null Eigenvalue"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Both categories. LEANBACK_LAUNCHER is the one a television's
                 home screen reads, and without it the app installs and then
                 cannot be started from the set at all; LAUNCHER is kept so the
                 same APK is reachable on a handset and from `adb shell am`. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- audio_service's own service and media-button receiver. They are
             its classes, not ours, which is what the Instantiatable
             suppression is about: lint cannot see them from this module. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- How the downloaded APK reaches the package installer. A file:// URI
             has thrown FileUriExposedException since Nougat, so the file is
             handed over as a content URI with a read grant that lasts only as
             long as the installer does. The authority is matched literally in
             MainActivity. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths"/>
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
